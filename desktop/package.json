{
  "name": "quietbrief-desktop",
  "version": "1.0.0",
  "description": "Cross-platform QuietBrief desktop app with native Windows WASAPI & macOS ScreenCaptureKit loopback + local CUDA/Apple Silicon Ollama bridge.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "app.quietbrief.desktop",
    "productName": "QuietBrief",
    "files": ["main.cjs", "preload.cjs", "../dist/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "arch": ["x64", "arm64"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "arch": ["arm64", "x64"]
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
